# Copy to .env (scripts/setup.sh does this and fills in random tokens).
# Everything about the bar itself (position, size, texts, branding) is set in the web UI.

HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
RUST_LOG=info

# Two secrets, at least 32 characters each: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME
CLIENT_TOKEN=CHANGE_ME

# Days to keep resolved messages in the history.
RETENTION_DAYS=90

# --- Optional: connect to a service provider's hub --------------------------
# Both values come from your service provider. See docs/HUB.md.
HUB_URL=
HUB_TOKEN=

# --- License -----------------------------------------------------------------
# Free up to 10 computers, and always when connected to a hub (HUB_URL above).
# Beyond that, enter your license key. Nothing is ever blocked without one; the
# web UI only shows a notice. See "License" in README.md.
LICENSE_KEY=

# --- Optional: Active Directory / LDAP ---------------------------------------
# no  = sign in with ADMIN_TOKEN; target everyone or computers by name pattern.
# yes = sign in with a directory account; additionally target groups, OUs, users.
AD_ENABLED=no
# ldap:// is upgraded with StartTLS, ldaps:// uses TLS. Certificates are always verified.
AD_URL=ldap://dc01.example.local:389
AD_BIND_DN=CN=svc_statusbar,OU=Service Accounts,DC=example,DC=local
AD_BIND_PASSWORD=CHANGE_ME
AD_BASE_DN=DC=example,DC=local
# Members of this group may sign in to the web UI.
AD_ADMIN_GROUP=Statusbar-Admins
AD_SYNC_SECONDS=300
ADMIN_SESSION_HOURS=8
