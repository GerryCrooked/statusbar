# Copy to .env, edit all CHANGE_ME entries. Use a secure HTTPS reverse proxy.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
LISTEN_ADDR=0.0.0.0:8080
DATABASE_PATH=/data/status.sqlite
RUST_LOG=info
# Generate random secrets: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_ADMIN_RANDOM_64_HEX
WEBHOOK_TOKEN=CHANGE_ME_WEBHOOK_RANDOM_64_HEX
CLIENT_TOKEN=CHANGE_ME_CLIENT_RANDOM_64_HEX
# Disable for first smoke test; enable for production directory targeting.
AD_ENABLED=false
# LDAPS with trusted certificate. Never disable certificate validation.
# LDAP on port 389 is automatically upgraded using StartTLS. Requires trusted DC certificate.
AD_URL=ldap://dc01.example.local:389
AD_BIND_DN=CN=svc_status,OU=Service Accounts,DC=example,DC=local
AD_BIND_PASSWORD=CHANGE_ME_AD_PASSWORD
AD_BASE_DN=DC=example,DC=local
# Optional custom LDAP filter: active AD user objects; not including disabled accounts
AD_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
AD_SYNC_SECONDS=300
# Only members of this AD group may log into the web administration.
AD_ADMIN_GROUP=Serveradmin
ADMIN_SESSION_HOURS=8
# Duration for green resolved state on clients (seconds)
RESOLVED_DISPLAY_SECONDS=90
# Client poll interval (seconds), clients use the same value from their config
