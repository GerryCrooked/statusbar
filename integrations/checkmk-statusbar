#!/usr/bin/env python3
# Statusbar
# Bulk: no
#
# Checkmk notification plugin. Install on the site as
#   ~/local/share/check_mk/notifications/statusbar   (chmod +x)
# then create a notification rule with method "Statusbar" and put the webhook URL
#   https://status.example.com/api/hooks/<integration token>
# into the first parameter.
import json
import os
import sys
import urllib.request

env = os.environ
url = env.get("NOTIFY_PARAMETER_1", "")
if not url.startswith("http"):
    sys.stderr.write("Parameter 1 must be the Statusbar webhook URL\n")
    sys.exit(2)

kind = env.get("NOTIFY_NOTIFICATIONTYPE", "")
if kind not in ("PROBLEM", "RECOVERY"):
    # Acknowledgements, downtimes and flapping notices are not shown to end users.
    sys.exit(0)

is_service = env.get("NOTIFY_WHAT") == "SERVICE"
payload = {
    "host": env.get("NOTIFY_HOSTNAME", ""),
    "service": env.get("NOTIFY_SERVICEDESC", "") if is_service else "",
    "status": env.get("NOTIFY_SERVICESTATE" if is_service else "NOTIFY_HOSTSTATE", ""),
    "message": env.get("NOTIFY_SERVICEOUTPUT" if is_service else "NOTIFY_HOSTOUTPUT", ""),
}
request = urllib.request.Request(
    url, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"}
)
try:
    with urllib.request.urlopen(request, timeout=10) as response:
        sys.stdout.write(response.read().decode("utf-8", "replace") + "\n")
except Exception as error:  # Checkmk retries on exit code 1
    sys.stderr.write("Statusbar webhook failed: %s\n" % error)
    sys.exit(1)
